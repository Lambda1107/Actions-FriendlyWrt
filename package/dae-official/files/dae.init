#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95

PROG=/usr/bin/dae
ASSETS=/usr/share/v2ray

start_service() {
	local enabled config_file mode dir_mode kernel_btf

	config_load dae
	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get config_file config config_file /etc/dae/config.dae

	# Keep the entry config in the root-owned package directory. In particular,
	# don't follow a symlink into /tmp or load world-readable proxy credentials.
	case "$config_file" in
		/etc/dae/*) case "${config_file#/etc/dae/}" in */*|'') logger -t dae 'config_file must be directly under /etc/dae'; return 1;; esac ;;
		*) logger -t dae 'config_file must be directly under /etc/dae'; return 1 ;;
	esac
	if [ -L /etc/dae ] || [ ! -d /etc/dae ] || [ -L "$config_file" ] || [ ! -f "$config_file" ] || [ ! -s "$config_file" ]; then
		logger -t dae 'missing or insecure /etc/dae config (provide a regular, nonempty file)'
		return 1
	fi
	[ "$(stat -c %u /etc/dae)" = 0 ] && [ "$(stat -c %u "$config_file")" = 0 ] || {
		logger -t dae 'config directory and file must be owned by root'
		return 1
	}
	mode=$(stat -c %a "$config_file") || return 1
	dir_mode=$(stat -c %a /etc/dae) || return 1
	if [ $(( 0$mode & 077 )) -ne 0 ] || [ $(( 0$dir_mode & 022 )) -ne 0 ]; then
		logger -t dae 'config file must be private (mode 0600 or stricter) and its directory not group/other writable'
		return 1
	fi

	kernel_btf="/usr/lib/debug/boot/vmlinux-$(uname -r)"
	if [ ! -s /sys/kernel/btf/vmlinux ] && { [ -L "$kernel_btf" ] || [ ! -f "$kernel_btf" ] || [ ! -s "$kernel_btf" ]; }; then
		logger -t dae "missing persistent BTF for $(uname -r)"
		return 1
	fi
	if [ ! -s "$ASSETS/geoip.dat" ] || [ ! -s "$ASSETS/geosite.dat" ]; then
		logger -t dae 'missing v2ray-geoip or v2ray-geosite data'
		return 1
	fi

	DAE_LOCATION_ASSET="$ASSETS" "$PROG" validate -c "$config_file" || {
		logger -t dae 'configuration validation failed; refusing to start'
		return 1
	}

	procd_open_instance
	procd_set_param env "DAE_LOCATION_ASSET=$ASSETS"
	procd_set_param command "$PROG" run --config "$config_file"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
