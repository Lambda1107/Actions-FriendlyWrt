# Example only. The package does not install /etc/dae/config.dae or enable service.
# Copy this file to config.dae (mode 0600) only after adapting the DNS path.
# Preserve WireGuard management: never bind wg_aliyun or the router's WAN.
# Replace the temporary BTF symlink into /tmp with a persistent matching BTF
# before considering daemon autostart.
global {
    # Enable only for a controlled LAN cutover with a timed rollback:
    # lan_interface: br-lan
    # Do not set wan_interface: auto (would intercept router-local egress).
    auto_config_kernel_parameter: false
    so_mark_from_dae: 0
    bootstrap_resolver: '223.5.5.5:53'
    log_level: info
}

node {
    mihomo: 'socks5://127.0.0.1:7890'
}
group {
    via_mihomo {
        filter: name(mihomo)
        policy: fixed(0)
    }
}

dns {
    # This is dae's real-IP DNS. The LAN 53 handoff is configured separately
    # by the operator; do not bind to dnsmasq :53 or mihomo :5335 here.
    bind: 'tcp+udp://127.0.0.1:5336'
    upstream {
        # Keep dnsmasq for local lease names; this does not change its upstream.
        # Do not point dnsmasq upstream back to dae, which would create a loop.
        lan_dns: 'tcp+udp://127.0.0.1:53'
        cn_dns: 'udp://192.168.1.1:53'
        google: 'https://8.8.8.8/dns-query'
        cloudflare: 'https://1.1.1.1/dns-query'
        quad9: 'https://9.9.9.11/dns-query'
    }
    routing {
        request {
            # As with mihomo dns.ipv6: false, answer AAAA with empty NOERROR.
            qtype(aaaa) -> reject
            qname(suffix: lan, suffix: local) -> lan_dns
            qname(geosite:cn, geosite:private) -> cn_dns
            fallback: google
        }
        response {
            # These two are answer-based retries, NOT timeout failover or
            # parallel/fastest selection across the three DoH upstreams.
            upstream(google) && ip(geoip:private) -> cloudflare
            upstream(cloudflare) && ip(geoip:private) -> quad9
            fallback: accept
        }
    }
}

routing {
    dip(geoip:private) -> direct
    domain(geosite:cn) -> direct
    dip(geoip:cn) -> direct
    fallback: via_mihomo
}
